# Bu dosyayı ".env" olarak kopyalayıp kendi bilgilerinle doldur.
# .env dosyası ASLA GitHub'a yüklenmemeli (.gitignore içinde zaten hariç tutuldu).

# --- BINANCE ---
BINANCE_API_KEY=buraya_testnet_api_key_yapistir
BINANCE_API_SECRET=buraya_testnet_api_secret_yapistir
USE_TESTNET=true

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=buraya_botfather_tokenini_yapistir
TELEGRAM_CHAT_ID=buraya_kendi_chat_id_yapistir

# --- VERİTABANI ---
# Render'da Postgres eklediğinde otomatik verilecek, lokalde boş bırakabilirsin (sqlite kullanılır)
DATABASE_URL=

# --- SERMAYE ---
STARTING_BALANCE=100
MIN_RISK_USD=5

# --- PARİTELER ---
SYMBOLS=BTC/USDT,ETH/USDT
